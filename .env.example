# Copy this file to .env and fill in your values.

# --- Jira (optional, enables --jira ticket auto-creation) ---
# Get a free Jira Cloud API token at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-api-token
JIRA_PROJECT_KEY=WEB
JIRA_ISSUE_TYPE=Bug

# --- AI executive summary (optional, enables --ai) ---
# Free key at https://openrouter.ai/keys — uses a free-tier model by default.
OPENROUTER_API_KEY=your-openrouter-key
AI_MODEL=google/gemma-4-26b-a4b-it:free

# --- Competitor discovery (optional; falls back to a free DuckDuckGo scrape without it) ---
# Get a free-tier key at https://serpapi.com — much more reliable than scraping search HTML directly.
SERPAPI_KEY=your-serpapi-key

# --- Slack (optional, enables --slack and the dashboard's Slack buttons) ---
# Create an app at https://api.slack.com/apps, add the chat:write bot scope,
# install it to your workspace, then invite it into the target channel
# (type /invite @<bot-name> in that channel).
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_CHANNEL_ID=your-channel-id

# --- Web dashboard (optional) ---
# Port for `auditcli view` local dashboard server.
DASHBOARD_PORT=4545
